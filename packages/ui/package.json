{
  "name": "@virgulimaginaria/ui",
  "version": "0.0.0",
  "description": "Accessible, domain-agnostic React components for the Primeira Academia Design System, built on shadcn/ui and Base UI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgulimaginaria/design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/virgulimaginaria/design-system/tree/main/packages/ui#readme",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./button": {
      "@virgulimaginaria/source": "./src/components/button.tsx",
      "types": "./dist/components/button.d.ts",
      "default": "./dist/components/button.js"
    },
    "./copy-button": {
      "@virgulimaginaria/source": "./src/components/copy-button.tsx",
      "types": "./dist/components/copy-button.d.ts",
      "default": "./dist/components/copy-button.js"
    },
    "./copyable-input": {
      "@virgulimaginaria/source": "./src/components/copyable-input.tsx",
      "types": "./dist/components/copyable-input.d.ts",
      "default": "./dist/components/copyable-input.js"
    },
    "./copyable-text": {
      "@virgulimaginaria/source": "./src/components/copyable-text.tsx",
      "types": "./dist/components/copyable-text.d.ts",
      "default": "./dist/components/copyable-text.js"
    },
    "./input": {
      "@virgulimaginaria/source": "./src/components/input.tsx",
      "types": "./dist/components/input.d.ts",
      "default": "./dist/components/input.js"
    },
    "./tooltip": {
      "@virgulimaginaria/source": "./src/components/tooltip.tsx",
      "types": "./dist/components/tooltip.d.ts",
      "default": "./dist/components/tooltip.js"
    },
    "./utils": {
      "@virgulimaginaria/source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./styles.css": "./dist/styles/globals.css",
    "./package.json": "./package.json"
  },
  "imports": {
    "#components/*": {
      "@virgulimaginaria/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "#hooks/*": {
      "@virgulimaginaria/source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "#lib/*": {
      "@virgulimaginaria/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@virgulimaginaria/design-tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
